# Copy to .env.local and fill in. Never commit .env.local.

# Booking link for "Book a call" buttons (e.g. Cal.com or Calendly). Falls back to /contact.
NEXT_PUBLIC_BOOKING_URL=https://cal.com/your-handle/intro

# Supabase (audit form leads -> public.audit_requests).
# Use the project URL and the PUBLIC publishable/anon key only. Never the secret/service_role key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-key
