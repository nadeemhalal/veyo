# Copy to .env.local and fill in. Never commit .env.local.

# Booking link for "Book a call" buttons (e.g. Cal.com or Calendly). Falls back to /contact.
NEXT_PUBLIC_BOOKING_URL=https://cal.com/your-handle/intro

# Supabase (audit form leads -> public.audit_requests).
# Use the project URL and the PUBLIC publishable/anon key only. Never the secret/service_role key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-key

# Public site address used in emailed links (e.g. your Vercel URL until the domain is live).
NEXT_PUBLIC_SITE_URL=https://veyomedia.com

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Build-time variable. Leave unset to disable tracking.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Optional: Search Console HTML-tag verification token (the content value only). DNS verification needs no code.
NEXT_PUBLIC_GSC_VERIFICATION=

# Email for the audit checklist "Send to email" button (Resend). Server-only: never prefix with NEXT_PUBLIC_.
# EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=re_your-key
EMAIL_FROM=Veyo Media <hello@veyomedia.com>
